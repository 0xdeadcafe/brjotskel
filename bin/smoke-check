#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

step=1
announce() {
  echo "[$step/8] $*"
  step=$((step + 1))
}

announce "shell syntax"
mapfile -t shell_scripts < <(
  git ls-files | while IFS= read -r path; do
    [[ -f "$path" ]] || continue
    if [[ "$path" == *.sh ]]; then
      printf '%s\n' "$path"
      continue
    fi
    first_line=$(head -n 1 "$path" 2>/dev/null || true)
    if [[ "$first_line" =~ ^#!.*(ba|z|k)?sh ]]; then
      printf '%s\n' "$path"
    fi
  done | sort -u
)
for script in "${shell_scripts[@]}"; do
  bash -n "$script"
done

announce "python syntax"
mapfile -t python_scripts < <(
  git ls-files | while IFS= read -r path; do
    [[ -f "$path" ]] || continue
    if [[ "$path" == *.py ]]; then
      printf '%s\n' "$path"
      continue
    fi
    first_line=$(head -n 1 "$path" 2>/dev/null || true)
    if [[ "$first_line" == '#!'*python* ]]; then
      printf '%s\n' "$path"
    fi
  done | sort -u
)
if ((${#python_scripts[@]} > 0)); then
  python3 -m py_compile "${python_scripts[@]}"
fi

announce "extension syntax"
mapfile -t extension_scripts < <(git ls-files '.pi/extensions/*.ts' '.pi/extensions/lib/*.ts' | sort -u)
for script in "${extension_scripts[@]}"; do
  node --check "$script" >/dev/null
done

announce "PowerShell syntax"
mapfile -t powershell_scripts < <(git ls-files '*.ps1' | sort -u)
if command -v pwsh >/dev/null 2>&1; then
  for script in "${powershell_scripts[@]}"; do
    POWERSHELL_SYNTAX_PATH="$script" pwsh -NoProfile -NonInteractive -Command '
      $path = $env:POWERSHELL_SYNTAX_PATH
      $tokens = $null
      $errors = $null
      [System.Management.Automation.Language.Parser]::ParseFile($path, [ref]$tokens, [ref]$errors) | Out-Null
      if ($errors.Count -gt 0) {
        foreach ($err in $errors) { Write-Error ("{0}: {1}" -f $path, $err.Message) }
        exit 1
      }
    '
  done
else
  echo "pwsh not found; skipping ${#powershell_scripts[@]} PowerShell script(s)"
  if [[ "${BRJOTSKEL_REQUIRE_PWSH:-0}" == "1" ]]; then
    echo "BRJOTSKEL_REQUIRE_PWSH=1 set; PowerShell syntax coverage is required" >&2
    exit 1
  fi
fi

announce "banned-pattern checks"
if git grep -n -E "BRJOTSKEL_AUTH_CONTEXT|ensureAuthContext" -- .pi/extensions/remote-session.ts >/dev/null; then
  echo "Found deprecated auth-context reference(s)"
  exit 1
fi
if git grep -n -E "crackmapexec|CrackMapExec" -- README.md docs .pi/extensions .pi/skills >/dev/null; then
  echo "Found stale CrackMapExec references; use netexec consistently"
  exit 1
fi

announce "build integrity metadata"
for path in bin/build-manifest bin/image-sbom; do
  if [[ ! -x "$path" ]]; then
    echo "Build integrity helper missing or not executable: $path" >&2
    exit 1
  fi
done
if [[ -f Dockerfile ]] && ! grep -q "/opt/brjotskel/BUILD-MANIFEST.json" Dockerfile; then
  echo "Dockerfile must generate /opt/brjotskel/BUILD-MANIFEST.json" >&2
  exit 1
fi
if [[ -f .github/workflows/ci.yml ]]; then
  if ! grep -q "bin/image-sbom brjotskel:ci" .github/workflows/ci.yml; then
    echo "CI must generate an SBOM artifact with bin/image-sbom" >&2
    exit 1
  fi
  if ! grep -E -q "brjotskel-build-integrity|upload-artifact" .github/workflows/ci.yml; then
    echo "CI must upload build integrity artifacts" >&2
    exit 1
  fi
fi

announce "shebang executable bit check"
missing_x=0
mapfile -t shebang_scripts < <(
  git ls-files | while IFS= read -r path; do
    [[ -f "$path" ]] || continue
    first_line=$(head -n 1 "$path" 2>/dev/null || true)
    [[ "$first_line" =~ ^#! ]] || continue
    printf '%s\n' "$path"
  done | sort -u
)
for script in "${shebang_scripts[@]}"; do
  if [[ ! -x "$script" ]]; then
    echo "Missing +x: $script"
    missing_x=$((missing_x + 1))
  fi
done
if ((missing_x > 0)); then
  echo "$missing_x shebang script(s) missing executable bit. Run: git ls-files | xargs -I{} bash -c 'head -1 {} | grep -q \"^#!\" && chmod +x {}'"
  exit 1
fi

announce "done"
echo "smoke-check: OK"
