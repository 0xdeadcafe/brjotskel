#!/usr/bin/env python3
"""Emit brjotskel image build/version provenance as JSON.

Runs inside the container image during Docker build. Native stdlib only.
"""
from __future__ import annotations

import hashlib
import json
import os
import pathlib
import subprocess
import sys
from typing import Any


DEFAULT_OUTPUT = "/opt/brjotskel/BUILD-MANIFEST.json"


PIN_ENV_KEYS = [
    "BRJOTSKEL_BASE_IMAGE",
    "NETEXEC_COMMIT",
    "NODE_VERSION",
    "NODE_LINUX_X64_SHA256",
    "NODE_LINUX_ARM64_SHA256",
    "PI_CODING_AGENT_VERSION",
    "PI_SMART_FETCH_VERSION",
    "POWERSHELL_VERSION",
    "RUST_TOOLCHAIN",
]

SOURCE_ENV_KEYS = [
    "BRJOTSKEL_BUILD_REF",
    "BRJOTSKEL_BUILD_DATE",
    "BRJOTSKEL_BUILD_URL",
]

FILE_HASH_PATHS = [
    "/opt/brjotskel/CONSTITUTION.md",
    "/opt/brjotskel/README.md",
    "/opt/brjotskel/.pi/settings.json",
]


def run(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, text=True, capture_output=True, check=False)


def command_lines(cmd: list[str]) -> list[str]:
    proc = run(cmd)
    output = "\n".join(part for part in [proc.stdout, proc.stderr] if part).strip()
    return [line.strip() for line in output.splitlines() if line.strip()]


def first_line(cmd: list[str]) -> str | None:
    lines = command_lines(cmd)
    return lines[0] if lines else None


def last_line(cmd: list[str]) -> str | None:
    lines = command_lines(cmd)
    return lines[-1] if lines else None


def command_output(cmd: list[str]) -> str:
    proc = run(cmd)
    if proc.returncode != 0:
        return ""
    return proc.stdout


def dpkg_packages() -> list[dict[str, str]]:
    output = command_output(["dpkg-query", "-W", "-f=${Package}\t${Version}\t${Architecture}\n"])
    packages: list[dict[str, str]] = []
    for line in output.splitlines():
        parts = line.split("\t")
        if len(parts) != 3:
            continue
        packages.append({"name": parts[0], "version": parts[1], "architecture": parts[2]})
    return packages


def pip_packages() -> list[dict[str, str]]:
    output = command_output(["python3", "-m", "pip", "freeze", "--all"])
    packages: list[dict[str, str]] = []
    for line in output.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if " @ " in line:
            name, ref = line.split(" @ ", 1)
            packages.append({"name": name, "version": ref})
        elif "==" in line:
            name, version = line.split("==", 1)
            packages.append({"name": name, "version": version})
        else:
            packages.append({"name": line, "version": "unknown"})
    return packages


def npm_global_packages() -> list[dict[str, str]]:
    output = command_output(["npm", "ls", "-g", "--depth=0", "--json"])
    if not output:
        return []
    try:
        data = json.loads(output)
    except json.JSONDecodeError:
        return []
    deps = data.get("dependencies") or {}
    packages: list[dict[str, str]] = []
    for name, meta in sorted(deps.items()):
        if isinstance(meta, dict):
            packages.append({"name": name, "version": str(meta.get("version", "unknown"))})
    return packages


def pi_settings_packages() -> list[str]:
    path = pathlib.Path("/opt/brjotskel/.pi/settings.json")
    if not path.exists():
        return []
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return []
    packages = data.get("packages") or []
    return [str(package) for package in packages]


def sha256_file(path: pathlib.Path) -> str | None:
    if not path.is_file():
        return None
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def file_hashes() -> list[dict[str, str]]:
    hashes: list[dict[str, str]] = []
    for raw_path in FILE_HASH_PATHS:
        path = pathlib.Path(raw_path)
        digest = sha256_file(path)
        if digest:
            hashes.append({"path": raw_path, "sha256": digest})
    return hashes


def tool_versions() -> dict[str, str | None]:
    return {
        "bash": first_line(["bash", "--version"]),
        "curl": first_line(["curl", "--version"]),
        "git": first_line(["git", "--version"]),
        "jq": first_line(["jq", "--version"]),
        "ncat": first_line(["ncat", "--version"]),
        "netexec": last_line(["netexec", "--version"]),
        "nmap": first_line(["nmap", "--version"]),
        "node": first_line(["node", "--version"]),
        "npm": first_line(["npm", "--version"]),
        "pi": first_line(["pi", "--version"]),
        "pwsh": first_line(["pwsh", "--version"]),
        "python3": first_line(["python3", "--version"]),
        "ssh": first_line(["ssh", "-V"]),
    }


def env_map(keys: list[str]) -> dict[str, str]:
    return {key: os.environ.get(key, "unknown") for key in keys}


def build_manifest() -> dict[str, Any]:
    os_release: dict[str, str] = {}
    os_path = pathlib.Path("/etc/os-release")
    if os_path.exists():
        for line in os_path.read_text(encoding="utf-8").splitlines():
            if "=" not in line or line.startswith("#"):
                continue
            key, value = line.split("=", 1)
            os_release[key] = value.strip('"')

    return {
        "schema_version": 1,
        "name": "brjotskel",
        "description": "AI-native incident response harness",
        "source": env_map(SOURCE_ENV_KEYS),
        "pinned_inputs": env_map(PIN_ENV_KEYS),
        "runtime_user": {
            "name": "brjotskel",
            "uid": os.environ.get("BRJOTSKEL_UID", "unknown"),
            "gid": os.environ.get("BRJOTSKEL_GID", "unknown"),
        },
        "os_release": os_release,
        "tool_versions": tool_versions(),
        "pi_packages": pi_settings_packages(),
        "file_hashes": file_hashes(),
        "package_inventory": {
            "dpkg": dpkg_packages(),
            "pip": pip_packages(),
            "npm_global": npm_global_packages(),
        },
        "known_non_hermetic_inputs": [
            "Debian apt repository metadata/packages are resolved at build time.",
            "Microsoft apt repository metadata/packages are resolved at build time.",
            "PyPI wheels and source distributions are resolved at build time, except Git dependencies pinned by commit.",
            "npm transitive dependencies are resolved at build time from the package registry.",
            "rustup bootstrap is downloaded at build time; the Rust toolchain version is pinned.",
        ],
    }


def main(argv: list[str]) -> int:
    output_path = pathlib.Path(argv[1] if len(argv) > 1 else DEFAULT_OUTPUT)
    manifest = build_manifest()
    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
