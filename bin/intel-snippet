def cmd_kerberos_ticket(args):
    data = {
        'type': 'kerberos-tgs' if args.ticket_type == 'tgs' else 'kerberos-tgt',
        'username': args.username,
        'domain': args.domain,
        'status': args.status,
        'notes': args.notes or (
            f'Kerberoastable SPN: {args.spn}' if args.spn else
            f'AS-REP roastable user: {args.username}' if args.ticket_type == 'asrep' else
            'Kerberos ticket'
        ),
    }
    if args.ticket_file:
        data['ticket_file'] = args.ticket_file
    if args.cracked_password:
        data['secret'] = args.cracked_password
        data['notes'] = (data.get('notes', '') + ' — plaintext password cracked').strip(' —')
    if args.spn:
        data['notes'] = data.get('notes', '') or f'SPN: {args.spn}'
    args.source_method = args.source_method or (
        'GetUserSPNs.py (kerberoasting)' if args.ticket_type in ('tgs', 'spn') else
        'GetNPUsers.py (AS-REP roast)' if args.ticket_type == 'asrep' else
        'Kerberos ticket recovery'
    )
    args.source_playbook = args.source_playbook or 'windows/enum-ad-spns.ps1'
    add_common_source(data, args)
    label = f'{args.username}@{args.domain}' if args.domain else args.username
    ticket_kind = {'tgs': 'TGS (Kerberoast)', 'tgt': 'TGT', 'asrep': 'AS-REP hash'}.get(args.ticket_type, args.ticket_type)
    print_result('credential', args.id, data,
                 args.summary or f'{ticket_kind} for {label} — {"cracked" if args.cracked_password else "captured"}')


def cmd_cloud_role(args):
    data = {
        'type': 'token',
        'username': args.role_name,
        'status': args.status,
        'notes': args.notes or (
            f'{args.provider.upper()} IAM role {args.role_name} attached to {args.source_host or "instance"}'
        ),
    }
    if args.access_key_id and args.secret_access_key:
        data['secret'] = f'{args.access_key_id}/{args.secret_access_key}' + (
            f'/{args.session_token}' if args.session_token else ''
        )
    elif args.token:
        data['secret'] = args.token
    if args.expiry:
        data['notes'] = (data.get('notes') or '') + f' — expires {args.expiry}'
    if args.provider == 'aws':
        data['notes'] = (data.get('notes') or '') + f' — blast radius = role policies in AWS account'
    elif args.provider == 'azure':
        data['notes'] = (data.get('notes') or '') + ' — blast radius = managed identity RBAC scope'
    elif args.provider == 'gcp':
        data['notes'] = (data.get('notes') or '') + ' — blast radius = service account IAM bindings'
    args.source_method = args.source_method or f'{args.provider.upper()} IMDS query'
    args.source_playbook = args.source_playbook or 'linux/enum-cloud-credentials.sh'
    add_common_source(data, args)
    print_result('credential', args.id, data,
                 args.summary or f'{args.provider.upper()} cloud identity {args.role_name} on {args.source_host or "instance"}')


def main():
    p = argparse.ArgumentParser(description='Generate ready intel_add snippets from gather-playbook findings.')
    sub = p.add_subparsers(dest='cmd', required=True)

    common = argparse.ArgumentParser(add_help=False)
    common.add_argument('--source-host')
    common.add_argument('--source-method')
    common.add_argument('--source-path')
    common.add_argument('--source-tool')
    common.add_argument('--source-playbook')
    common.add_argument('--summary')

    host = sub.add_parser('host-endpoint', parents=[common])
    host.add_argument('--id', required=True)
    host.add_argument('--ip')
    host.add_argument('--hostname')
    host.add_argument('--platform', default='unknown')
    host.add_argument('--role', default='unknown')
    host.add_argument('--status', default='suspected')
    host.add_argument('--attacker-role', default='unknown')
    host.add_argument('--endpoint', action='append')
    host.add_argument('--profile-artifact', action='append')
    host.add_argument('--access-method')
    host.add_argument('--access-credential')
    host.add_argument('--access-via')
    host.add_argument('--access-port', type=int)
    host.set_defaults(func=cmd_host)

    putty = sub.add_parser('putty-host', parents=[common])
    putty.add_argument('--id', required=True)
    putty.add_argument('--host', required=True)
    putty.add_argument('--hostname')
    putty.add_argument('--ip')
    putty.add_argument('--username')
    putty.add_argument('--port', type=int, default=22)
    putty.add_argument('--platform', default='unknown')
    putty.add_argument('--role', default='unknown')
    putty.add_argument('--status', default='suspected')
    putty.add_argument('--attacker-role', default='unknown')
    putty.add_argument('--session-name', required=True)
    putty.add_argument('--key-file')
    putty.add_argument('--access-credential')
    putty.add_argument('--access-via')
    putty.set_defaults(func=cmd_putty_host)

    ans = sub.add_parser('ansible-host', parents=[common])
    ans.add_argument('--id', required=True)
    ans.add_argument('--host', required=True)
    ans.add_argument('--inventory-name')
    ans.add_argument('--hostname')
    ans.add_argument('--ip')
    ans.add_argument('--username')
    ans.add_argument('--port', type=int, default=22)
    ans.add_argument('--platform', default='linux')
    ans.add_argument('--role', default='unknown')
    ans.add_argument('--status', default='suspected')
    ans.add_argument('--attacker-role', default='unknown')
    ans.add_argument('--access-credential')
    ans.add_argument('--access-via')
    ans.set_defaults(func=cmd_ansible_host)

    cred = sub.add_parser('credential', parents=[common])
    cred.add_argument('--id', required=True)
    cred.add_argument('--type', required=True)
    cred.add_argument('--username', required=True)
    cred.add_argument('--domain')
    cred.add_argument('--secret')
    cred.add_argument('--key-file')
    cred.add_argument('--ticket-file')
    cred.add_argument('--valid-on', action='append')
    cred.add_argument('--related-host', action='append')
    cred.add_argument('--status', default='active')
    cred.add_argument('--notes')
    cred.set_defaults(func=cmd_credential)

    psh = sub.add_parser('psreadline-credential', parents=[common])
    psh.add_argument('--id', required=True)
    psh.add_argument('--type', required=True)
    psh.add_argument('--username', required=True)
    psh.add_argument('--domain')
    psh.add_argument('--secret')
    psh.add_argument('--key-file')
    psh.add_argument('--valid-on', action='append')
    psh.add_argument('--related-host', action='append')
    psh.add_argument('--status', default='active')
    psh.add_argument('--notes')
    psh.add_argument('--user-profile')
    psh.add_argument('--line-number', type=int)
    psh.set_defaults(func=cmd_psreadline_credential)

    avh = sub.add_parser('av-path-host', parents=[common])
    avh.add_argument('--id', required=True)
    avh.add_argument('--exclusion-path', required=True)
    avh.add_argument('--endpoint')
    avh.add_argument('--hostname')
    avh.add_argument('--platform', default='windows')
    avh.add_argument('--role', default='unknown')
    avh.add_argument('--status', default='suspected')
    avh.add_argument('--attacker-role', default='unknown')
    avh.add_argument('--registry-path')
    avh.set_defaults(func=cmd_av_path_host)

    dns = sub.add_parser('dnscache-host', parents=[common])
    dns.add_argument('--id', required=True)
    dns.add_argument('--entry', required=True)
    dns.add_argument('--hostname')
    dns.add_argument('--ip')
    dns.add_argument('--platform', default='unknown')
    dns.add_argument('--role', default='unknown')
    dns.add_argument('--status', default='suspected')
    dns.add_argument('--attacker-role', default='unknown')
    dns.add_argument('--record-type')
    dns.add_argument('--data-value')
    dns.add_argument('--notes')
    dns.set_defaults(func=cmd_dnscache_host)

    usb = sub.add_parser('usb-artifact-host', parents=[common])
    usb.add_argument('--id', required=True)
    usb.add_argument('--hostname')
    usb.add_argument('--platform', default='windows')
    usb.add_argument('--role', default='workstation')
    usb.add_argument('--status', default='suspected')
    usb.add_argument('--attacker-role', default='unknown')
    usb.add_argument('--friendly-name')
    usb.add_argument('--container-id')
    usb.add_argument('--registry-path')
    usb.add_argument('--notes')
    usb.set_defaults(func=cmd_usb_artifact_host)

    vpnp = sub.add_parser('vpn-pivot', parents=[common])
    vpnp.add_argument('--id', required=True)
    vpnp.add_argument('--target', required=True)
    vpnp.add_argument('--hop', required=True)
    vpnp.add_argument('--method', default='vpn')
    vpnp.add_argument('--credential')
    vpnp.add_argument('--command')
    vpnp.add_argument('--status', default='suspected')
    vpnp.add_argument('--related-host', action='append')
    vpnp.add_argument('--notes')
    vpnp.add_argument('--config-path')
    vpnp.add_argument('--remote-host')
    vpnp.add_argument('--remote-port')
    vpnp.set_defaults(func=cmd_vpn_pivot)

    ada = sub.add_parser('ad-account', parents=[common])
    ada.add_argument('--id', required=True)
    ada.add_argument('--type', default='domain')
    ada.add_argument('--domain')
    ada.add_argument('--username', required=True)
    ada.add_argument('--privilege', action='append')
    ada.add_argument('--access-to', action='append')
    ada.add_argument('--credential', action='append')
    ada.add_argument('--related-host', action='append')
    ada.add_argument('--attacker-use')
    ada.add_argument('--status', default='compromised')
    ada.set_defaults(func=cmd_ad_account)

    rdp = sub.add_parser('rdp-host', parents=[common])
    rdp.add_argument('--id', required=True)
    rdp.add_argument('--host', required=True)
    rdp.add_argument('--hostname')
    rdp.add_argument('--ip')
    rdp.add_argument('--platform', default='windows')
    rdp.add_argument('--role', default='workstation')
    rdp.add_argument('--status', default='suspected')
    rdp.add_argument('--attacker-role', default='unknown')
    rdp.add_argument('--access-credential')
    rdp.add_argument('--access-via')
    rdp.set_defaults(func=cmd_rdp_host)

    brw = sub.add_parser('browser-host', parents=[common])
    brw.add_argument('--id', required=True)
    brw.add_argument('--endpoint', required=True)
    brw.add_argument('--host')
    brw.add_argument('--hostname')
    brw.add_argument('--ip')
    brw.add_argument('--browser')
    brw.add_argument('--platform', default='unknown')
    brw.add_argument('--role', default='unknown')
    brw.add_argument('--status', default='suspected')
    brw.add_argument('--attacker-role', default='unknown')
    brw.add_argument('--notes')
    brw.set_defaults(func=cmd_browser_host)

    cifs = sub.add_parser('cifs-pivot', parents=[common])
    cifs.add_argument('--id', required=True)
    cifs.add_argument('--target', required=True)
    cifs.add_argument('--hop', required=True)
    cifs.add_argument('--credential')
    cifs.add_argument('--command')
    cifs.add_argument('--status', default='suspected')
    cifs.add_argument('--related-host', action='append')
    cifs.add_argument('--notes')
    cifs.add_argument('--config-path')
    cifs.add_argument('--share-path', required=True)
    cifs.set_defaults(func=cmd_cifs_pivot)

    piv = sub.add_parser('pivot', parents=[common])
    piv.add_argument('--id', required=True)
    piv.add_argument('--target', required=True)
    piv.add_argument('--hop', required=True)
    piv.add_argument('--method', required=True)
    piv.add_argument('--credential')
    piv.add_argument('--command')
    piv.add_argument('--tunnel')
    piv.add_argument('--status', default='suspected')
    piv.add_argument('--related-host', action='append')
    piv.add_argument('--notes')
    piv.add_argument('--evidence-kind')
    piv.add_argument('--evidence-host')
    piv.add_argument('--evidence-path')
    piv.set_defaults(func=cmd_pivot)

    krb = sub.add_parser('kerberos-ticket', parents=[common],
                         help='Kerberoast TGS, AS-REP hash, or TGT — with optional cracked plaintext')
    krb.add_argument('--id', required=True)
    krb.add_argument('--username', required=True)
    krb.add_argument('--domain')
    krb.add_argument('--ticket-type', choices=['tgs', 'tgt', 'asrep'], default='tgs')
    krb.add_argument('--spn')
    krb.add_argument('--ticket-file')
    krb.add_argument('--cracked-password', help='Plaintext if cracked from hashcat/john')
    krb.add_argument('--status', default='active')
    krb.add_argument('--notes')
    krb.set_defaults(func=cmd_kerberos_ticket)

    cld = sub.add_parser('cloud-role', parents=[common],
                         help='Cloud IAM role / managed identity attached to a compromised instance')
    cld.add_argument('--id', required=True)
    cld.add_argument('--provider', choices=['aws', 'azure', 'gcp'], required=True)
    cld.add_argument('--role-name', required=True)
    cld.add_argument('--access-key-id')
    cld.add_argument('--secret-access-key')
    cld.add_argument('--session-token')
    cld.add_argument('--token', help='Azure/GCP bearer token')
    cld.add_argument('--expiry')
    cld.add_argument('--status', default='active')
    cld.add_argument('--notes')
    cld.set_defaults(func=cmd_cloud_role)

    args = p.parse_args()
    args.func(args)


if __name__ == '__main__':
    main()
